{
  "name": "zion",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de terminal para simulacao de consciencia espacial",
  "type": "module",
  "scripts": {
    "start": "node scripts/prisma-command.js migrate deploy && node src/main.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node --test --test-reporter=spec test/unit/dashboard.test.js test/unit/menu-guard.test.js test/unit/session-log.test.js test/unit/auth.test.js test/unit/prompt-input.test.js",
    "test:integration": "node --test --test-reporter=spec test/integration/cli.test.js test/integration/database.test.js",
    "test:security": "node --test --test-reporter=spec test/security/security.test.js test/security/terminal-input.test.js test/security/report-observability.test.js",
    "security:audit": "npm audit --audit-level=high",
    "db:migrate": "node scripts/prisma-command.js migrate deploy",
    "db:migrate:dev": "node scripts/prisma-command.js migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@prisma/client": "^6.19.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
