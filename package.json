{
  "name": "zion",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de terminal para simulacao de consciencia espacial",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:security",
    "test:unit": "node --test test/unit/dashboard.test.js",
    "test:integration": "node --test test/integration/cli.test.js",
    "test:security": "node --test test/security/security.test.js",
    "security:audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  }
}
